<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Timo Hoyland – Engineer, business owner, and coach. Supporting teams and improving IT services across agency, enterprise, and client-facing environments.">
    <meta name="keywords" content="Timo Hoyland, engineer, IT services, DevOps, team building, reliability, NottInfra">
    <meta name="author" content="Timo Hoyland">
    <meta name="robots" content="index, follow">

    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ .BaseURL }}/">
    <meta property="og:title" content="Timo Hoyland | Engineer | Business Owner | Coach">
    <meta property="og:description" content="Supporting teams and improving IT services across agency, enterprise, client-facing environments. Focus on team-building, reliability, cost measures.">
    <meta property="og:locale" content="en_GB">
    <meta property="og:site_name" content="Timo Hoyland">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Timo Hoyland | Engineer | Business Owner | Coach">
    <meta name="twitter:description" content="Supporting teams and improving IT services across agency, enterprise, client-facing environments.">

    <title>Timo Hoyland | Engineer | Business Owner | Coach</title>
    <link rel="canonical" href="{{ .BaseURL }}/">
    {{ template "layout_styles" . }}
    {{ template "analytics" . }}
</head>
<body>
    {{ template "header" . }}
    <main role="main" id="main-content">
        {{ range .Articles }}
        <article aria-labelledby="article-{{ .Slug }}-title">
            <hr aria-hidden="true">
            <h2 id="article-{{ .Slug }}-title">{{ .Title }}</h2>
            <p>{{ .Excerpt }}</p>
            <a href="/article/{{ .Slug }}" aria-label="Read more: {{ .Title }}">Read more</a>
        </article>
        {{ end }}
    </main>
    {{ template "footer" . }}
</body>
</html>
