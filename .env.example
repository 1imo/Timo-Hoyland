# Per-environment values. Shared secrets live in `.env.shared`.
# Service hosts live in settings.cfg → ENDPOINTS; NETWORK=cluster|public selects them.
# Push to Vault: ./cmd/apply-env.ps1

# ── Core ──────────────────────────────────────────────────────────────────────
ENV=
NETWORK=

# ── Matomo (src) ──────────────────────────────────────────────────────────────
MATOMO_SITE_ID=

# ── GrowthBook (src) ──────────────────────────────────────────────────────────
GROWTHBOOK_CLIENT_KEY=

# ── OpenReplay (src) ──────────────────────────────────────────────────────────
# Prefer the ingest URL from the OpenReplay project install snippet when it differs
# from ENDPOINTS.OPENREPLAY (Go normalises a trailing /ingest).
OPENREPLAY_PROJECT_KEY=
# OPENREPLAY_INGEST_URL=https://openreplay.nottinfra.co.uk/ingest
# OPENREPLAY_SCRIPT_URL=https://static.openreplay.com/18.0.17/openreplay.js

# ── Sentry (src) ──────────────────────────────────────────────────────────────
SENTRY_PROJECT_ID=

# ── Database (cmd + src) — host from ENDPOINTS.DB via NETWORK ─────────────────
# DB name = {project}-{ENV}; cmd builds DB_URL for src.
DB_USER=
DB_PASSWORD=

# ── App overrides (src; optional) ─────────────────────────────────────────────
# PORT=8080
# BASE_URL=https://timohoyland.co.uk
# RATE_LIMIT_RPM=120
# ASSETS_DIR=
# GA4_MEASUREMENT_ID=
